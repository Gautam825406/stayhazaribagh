# Copy to .env for local development. NEVER commit .env.
# On Render, set these in the service Environment settings instead.

# Required in production. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Postgres on Render, e.g. postgresql://user:pass@host:5432/dbname
# Leave empty for local dev — the app falls back to SQLite
# (backend/stayhazaribagh.db).
DATABASE_URL=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://stayhazaribagh.vercel.app,http://localhost:5173

# Optional: path to the seed file used by `python -m backend.seed`.
# SEED_PATH=/home/hatch/workspace/stayhazaribagh-seed/seed.json
